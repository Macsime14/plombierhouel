# Clé API Resend (https://resend.com) pour l'envoi d'emails du formulaire de contact
RESEND_API_KEY=

# Adresse email du plombier qui recevra les demandes de contact
CONTACT_EMAIL_TO=

# Adresse d'expedition des emails. En attendant un domaine verifie dans Resend,
# utiliser onboarding@resend.dev (fonctionne uniquement pour des tests).
CONTACT_EMAIL_FROM=onboarding@resend.dev
